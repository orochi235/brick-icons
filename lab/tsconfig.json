{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@lab/*": ["src/*"],
      "@pezlie/wall/*": ["node_modules/pezlie/wall/*"],
      "@pezlie/host-brick-icons/*": ["node_modules/pezlie/hosts/brick-icons/*"]
    }
  },
  "include": ["src"]
}
