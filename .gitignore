.onto-fetch-cache.json

# No render slot is versioned. A slot is derived from the library and the
# engine, and it moves whenever the engine does -- the goldens gate is a byte
# diff, so an output-moving commit rewrites every file in every slot at once.
# The 18 SVGs in git are a hand-picked gallery, never a slot.
#
# This said the opposite ("a render slot is versioned as text") and nothing had
# ever acted on it: renders/occt was 7,931 files that were neither tracked nor
# ignored, which is the one combination that puts every `onto sync` over its
# request limit.
renders/**/*.svg
renders/**/*.png
renders/**/*.webp
# The reference bake's world -> pixel maps, one per render and regenerated with
# it. Ignored HERE rather than in .git/info/exclude so a node agrees: a file a
# node does not ignore but we do is untracked in tracked space there, and every
# later `onto sync` refuses rather than delete it.
renders/**/*.fit.json
